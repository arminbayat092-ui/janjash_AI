
from flask import Flask, request, jsonify

app = Flask(__name__)

@app.route("/", methods=["GET"])
def home():
    return jsonify({
        "name": "JANJASH AI",
        "status": "online",
        "version": "1.0"
    })

@app.route("/health", methods=["GET"])
def health():
    return jsonify({"status": "ok"})

@app.route("/chat", methods=["POST"])
def chat():
    data = request.get_json(silent=True) or {}
    message = data.get("message", "").strip()

    if not message:
        return jsonify({
            "error": "پیام خالی است"
        }), 400

    return jsonify({
        "assistant": "JANJASH AI",
        "message": message,
        "status": "received",
        "note": "موتور هوش مصنوعی هنوز متصل نشده است."
    })

if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=10000
    )
